{
  "name": "slimevr-website",
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "pnpm build:prepare && pnpm vinxi build && pnpm clean:worker",
    "clean:worker": "node -e \"require('fs').rmSync('dist/_worker.js', { force: true })\"",
    "build:prepare": "pnpm typecheck && pnpm generate:blog:paginationApi",
    "start": "vinxi start",
    "serve": "wrangler pages dev .output/public --port 3000",
    "preview": "pnpm build && pnpm serve",
    "test": "vitest",
    "test-run": "vitest run --reporter=verbose",
    "test-coverage": "vitest run --coverage --reporter=verbose",
    "test-ci": "pnpm test-coverage",
    "typecheck": "tsc --noEmit",
    "generate:blog:paginationApi": "node src/features/blog/tools/generateBlogPaginationApi.mts"
  },
  "dependencies": {
    "@solid-primitives/i18n": "^2.2.1",
    "@solid-primitives/intersection-observer": "^2.2.5",
    "@solid-primitives/media": "^2.3.6",
    "@solid-primitives/storage": "^4.4.0",
    "@solidjs/meta": "^0.29.8",
    "@solidjs/router": "^0.16.3",
    "@solidjs/start": "1.5.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/solid-query": "^5.107.1",
    "clsx": "^2.1.1",
    "front-matter": "^4.0.2",
    "get-video-id": "^4.2.0",
    "hast-util-to-string": "^3.0.1",
    "js-yaml": "^5.5.0",
    "overlayscrollbars": "^2.17.0",
    "postcss": "^8.5.33",
    "rand-seed": "^3.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sitemap": "^10.0.0",
    "solid-js": "^1.9.19",
    "solid-markdown": "2.1.1",
    "tailwindcss": "4.3.5",
    "typescript-event-target": "^1.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vinxi": "^0.5.11",
    "vite-plugin-markdown": "^2.2.0"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/hast": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "7.0.2",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
